# --- Accès MPP (modes CLI et bot) ---
# Jeton d'accès copié depuis l'en-tête Authorization du site MPP (sans "Bearer ").
# Optionnel si vous utilisez un fichier de jetons avec refresh (recommandé) :
# .secrets/mpp-bot-tokens.json contenant {"access_token": "...", "refresh_token": "..."}
MPP_TOKEN=

# --- Fournisseurs de cotes optionnels (comparaison et backtests uniquement) ---
# Le bot et l'extension n'en ont pas besoin : Polymarket est public et sans clé.
ODDS_API_KEY=
API_FOOTBALL_KEY=
